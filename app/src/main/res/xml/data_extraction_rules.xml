<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Auto Backup ON: everything that survives a "lost phone → new phone with
         the same Google account" scenario lives here.

         What we back up:
         - `database/lingua.db`  — every logged lesson + every language config.
         - `file/datastore/`     — DataStore Preferences (user name, selfie
                                   path string, onboarding flag, last celebration
                                   date, nano-enabled toggle).

         What we don't back up:
         - `database/lingua.db-shm/-wal` — SQLite write-ahead-log temp files;
                                          excluded so we never restore a
                                          half-committed transaction state.
         - `file/selfies/`             — not in an `<include>`, so the backup
                                          agent skips it automatically. Lint
                                          forbids an explicit `<exclude>` for
                                          a path that isn't already included.
                                          Selfies are cheap to retake, count
                                          against the 25 MB per-app quota, and
                                          the path string in datastore will
                                          dangle harmlessly on restore (Home
                                          falls back to the initial-letter
                                          avatar if the file is missing). -->
    <cloud-backup>
        <include domain="database" path="lingua.db" />
        <include domain="sharedpref" />
        <include domain="file" path="datastore/" />
        <exclude domain="database" path="lingua.db-shm" />
        <exclude domain="database" path="lingua.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lingua.db" />
        <include domain="sharedpref" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
