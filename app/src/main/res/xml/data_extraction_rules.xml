<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Auto Backup ON: include the Room database in cloud backups so quotas survive
         factory reset / new device via the user's Google account. -->
    <cloud-backup>
        <include domain="database" path="lingua.db" />
        <include domain="sharedpref" />
        <exclude domain="database" path="lingua.db-shm" />
        <exclude domain="database" path="lingua.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lingua.db" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
